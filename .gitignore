# Data — never commit the raw dataset
data/raw/
data/raw/data_clean.csv
*.csv

# Processed data — allow parquet artifacts for app deployment
!data/processed/*.parquet
!data/processed/meta.json

# dbt — never commit credentials
dbt/profiles.yml

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/
.env

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Models — serialized artifacts can be large
# models/artifacts/*.pkl   <-- commented out
# models/artifacts/*.joblib

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
.venv/
dbt/target/
dbt/logs/
dbt/dbt_packages/
*.duckdb
