# Copy this file to profiles.yml and fill in your BigQuery credentials.
# profiles.yml is gitignored and should never be committed.

student_dropout:
  target: dev
  outputs:
    dev:
      type: bigquery
      method: service-account
      project: your-gcp-project-id
      dataset: student_dropout_dev
      keyfile: /path/to/your/service-account-key.json
      location: US
      threads: 4
      timeout_seconds: 300
